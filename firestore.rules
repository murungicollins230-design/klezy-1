rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every user's data lives under users/{uid}/... — this rule ensures
    // someone can only ever read or write their own subtree, identified
    // by their Firebase Auth uid (anonymous or upgraded to email).
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
